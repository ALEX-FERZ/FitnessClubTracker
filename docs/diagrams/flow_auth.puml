@startuml flow_auth
title Регистрация и вход (AuthService)
start
if (Действие?) then (регистрация)
    :Ввод логина, пароля, ФИО, телефона;
    if (Логин 3–32 символа\n[A-Za-z0-9_]?) then (нет)
        :Ошибка;
        stop
    endif
    if (Пароль ≥ 6 символов,\nФИО не пустое,\nтелефон корректен?) then (нет)
        :Ошибка;
        stop
    endif
    if (Логин свободен?) then (нет)
        :Ошибка «Логин уже занят»;
        stop
    endif
    :Сохранить пользователя\nс ролью «Клиент»\nи хэшем пароля;
    :Сообщение об успешной регистрации;
    stop
else (вход)
    :Ввод логина и пароля;
    if (Пользователь найден и\nхэш пароля совпадает?) then (нет)
        :Ошибка «Неверный логин или пароль»;
        stop
    endif
    switch (Роль?)
    case (Администратор)
        :Меню администратора;
    case (Тренер)
        :Меню тренера;
    case (Клиент)
        :Меню клиента;
    endswitch
    stop
endif
@enduml
