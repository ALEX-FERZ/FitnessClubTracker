@startuml flow_add_lesson
title Добавление занятия в расписание (LessonService::createLesson)
start
:Администратор вводит тренера, название,\nдату и время, количество мест;
if (Тренер существует?) then (нет)
    :Ошибка «Тренер не найден»;
    stop
endif
if (Название не пустое?) then (нет)
    :Ошибка;
    stop
endif
if (Дата в формате ГГГГ-ММ-ДД ЧЧ:ММ\nи не в прошлом?) then (нет)
    :Ошибка формата / даты;
    stop
endif
if (Мест от 1 до 100?) then (нет)
    :Ошибка вместимости;
    stop
endif
:Получить занятия этого тренера;
while (Есть непроверенное занятие?) is (да)
    if (Разница во времени < 60 минут?) then (да)
        :Ошибка «Накладка в расписании»;
        stop
    endif
endwhile (нет)
:Сохранить занятие в БД;
:Сообщение «Занятие добавлено»;
stop
@enduml
