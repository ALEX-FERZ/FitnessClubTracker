@startuml er
' ER-диаграмма базы данных (ЛР №3). Нотация «вороньи лапки».
hide circle
skinparam linetype ortho
skinparam roundcorner 6

entity "roles" as roles {
    * role_id : INTEGER <<PK>>
    --
    * name : TEXT <<UNIQUE>>
}

entity "users" as users {
    * user_id : INTEGER <<PK>>
    --
    * login : TEXT <<UNIQUE>>
    * password_hash : TEXT
    * role_id : INTEGER <<FK>>
    * full_name : TEXT
    phone : TEXT
}

entity "lessons" as lessons {
    * lesson_id : INTEGER <<PK>>
    --
    * trainer_id : INTEGER <<FK>>
    * title : TEXT
    * starts_at : TEXT (YYYY-MM-DD HH:MM)
    * capacity : INTEGER
}

entity "subscriptions" as subscriptions {
    * subscription_id : INTEGER <<PK>>
    --
    * client_id : INTEGER <<FK>>
    * type : TEXT
    * start_date : TEXT (YYYY-MM-DD)
    * end_date : TEXT (YYYY-MM-DD)
    * visits_left : INTEGER
}

entity "bookings" as bookings {
    * booking_id : INTEGER <<PK>>
    --
    * client_id : INTEGER <<FK>>
    * lesson_id : INTEGER <<FK>>
    * created_at : TEXT
    * status_id : INTEGER <<FK>>
}

entity "booking_statuses" as statuses {
    * status_id : INTEGER <<PK>>
    --
    * name : TEXT <<UNIQUE>>
}

roles ||--o{ users : "роль"
users ||--o{ lessons : "тренер ведёт"
users ||--o{ subscriptions : "клиент имеет"
users ||--o{ bookings : "клиент записан"
lessons ||--o{ bookings : "на занятие"
statuses ||--o{ bookings : "статус"

note bottom of bookings
  bookings — таблица связи M:N
  между клиентами (users) и занятиями (lessons)
end note
@enduml
