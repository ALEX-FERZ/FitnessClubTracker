@startuml flow_cancel
title Отмена записи (BookingService::cancel)
start
:Клиент выбирает свою активную запись;
if (Запись существует и принадлежит клиенту?) then (нет)
    :Ошибка;
    stop
endif
if (Запись активна?) then (нет)
    :Ошибка «Запись уже отменена»;
    stop
endif
if (До начала занятия больше 2 часов?) then (нет)
    :Ошибка «Отменить можно не позднее\nчем за 2 часа»;
    stop
endif
:status = «Отменена»;
:Вернуть посещение на абонемент;
:Сообщение «Запись отменена»;
stop
@enduml
