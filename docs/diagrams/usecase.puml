@startuml usecase
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Клиент" as client
actor "Тренер" as trainer
actor "Администратор" as admin

rectangle "Fitness Club Tracker" {
    usecase "Регистрация" as UC_Register
    usecase "Вход в систему" as UC_Login
    usecase "Просмотр расписания\n(фильтр по дате и тренеру)" as UC_Schedule

    usecase "Запись на занятие" as UC_Book
    usecase "Проверка свободных мест" as UC_CheckPlaces
    usecase "Проверка абонемента" as UC_CheckSub
    usecase "Отмена записи" as UC_Cancel
    usecase "Просмотр своих записей\nи абонемента" as UC_MyData

    usecase "Просмотр своих занятий\nи списка записавшихся" as UC_TrainerLessons

    usecase "Управление расписанием\n(добавить, изменить, удалить)" as UC_EditSchedule
    usecase "Проверка накладок\nу тренера" as UC_CheckConflict
    usecase "Управление тренерами" as UC_Trainers
    usecase "Управление клиентами" as UC_Clients
    usecase "Оформление абонемента" as UC_IssueSub
    usecase "Просмотр всех записей" as UC_AllBookings
    usecase "Экспорт расписания\n(JSON, CSV, XML, YAML)" as UC_Export
}

client --> UC_Register
client --> UC_Login
client --> UC_Schedule
client --> UC_Book
client --> UC_Cancel
client --> UC_MyData

trainer --> UC_Login
trainer --> UC_Schedule
trainer --> UC_TrainerLessons

admin --> UC_Login
admin --> UC_Schedule
admin --> UC_EditSchedule
admin --> UC_Trainers
admin --> UC_Clients
admin --> UC_IssueSub
admin --> UC_AllBookings
admin --> UC_Export

UC_Book ..> UC_CheckPlaces : <<include>>
UC_Book ..> UC_CheckSub : <<include>>
UC_EditSchedule ..> UC_CheckConflict : <<include>>
UC_IssueSub ..> UC_Clients : <<extend>>
@enduml
