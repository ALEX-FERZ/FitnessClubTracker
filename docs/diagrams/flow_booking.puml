@startuml flow_booking
title Запись клиента на занятие (BookingService::book)
start
:Клиент выбирает занятие из расписания;
if (Пользователь — клиент?) then (нет)
    :Ошибка «Записываться может только клиент»;
    stop
endif
if (Занятие существует?) then (нет)
    :Ошибка «Занятие не найдено»;
    stop
endif
if (Занятие ещё не началось?) then (нет)
    :Ошибка «Занятие уже прошло»;
    stop
endif
if (Клиент уже записан на это занятие?) then (да)
    :Ошибка «Вы уже записаны»;
    stop
endif
if (Есть свободные места?) then (нет)
    :Ошибка «Свободных мест нет»;
    stop
endif
if (Есть абонемент, действующий на дату\nзанятия, с остатком посещений > 0?) then (нет)
    :Ошибка «Нет действующего абонемента»;
    stop
endif
:Создать запись (status = «Активна»);
:Списать одно посещение с абонемента;
:Сообщение «Вы записаны»;
stop
@enduml
